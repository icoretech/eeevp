{
  "name": "eeevp",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "packageManager": "yarn@4.18.1",
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "react-doctor": "0.9.18",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1153.0",
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "shadcn": "^4.22.1",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:worker": "node scripts/build-worker.mjs",
    "build": "yarn build:worker && next build",
    "start": "next start --hostname 0.0.0.0",
    "biome:check": "biome check --write .",
    "biome:ci": "biome ci . --error-on-warnings",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:browser": "playwright test",
    "react-doctor": "REACT_DOCTOR_NO_TELEMETRY=1 react-doctor --no-score --no-supply-chain --scope full --blocking warning",
    "react-doctor:ci": "REACT_DOCTOR_NO_TELEMETRY=1 react-doctor --no-score --no-supply-chain --scope full --blocking warning"
  },
  "dependenciesMeta": {
    "esbuild": {
      "built": true
    }
  }
}
