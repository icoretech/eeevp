# Private encryption keys are never server configuration.
APP_ORIGIN=http://localhost:3000
SESSION_SECRET=replace-with-at-least-32-random-secret-characters
DEMO_MODE=false
STORAGE_DRIVER=filesystem
STORAGE_PATH=/app/data

# DEMO_PUBLIC_KEY is required only when DEMO_MODE=true and is deliberately public.
# Use a separate demo key, synthetic media, and an isolated storage prefix.
# DEMO_PUBLIC_KEY=

# Hosted Synteq Apps: set STORAGE_DRIVER=s3 and configure exactly one private bucket.
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=sample-video-library
# S3_ACCESS_KEY_ID=replace-with-a-bucket-scoped-access-key-id
# S3_SECRET_ACCESS_KEY=replace-with-a-bucket-scoped-secret-access-key
# S3_FORCE_PATH_STYLE=true
# S3_PREFIX=sample-library
